import '../../styles/global.css';
import { db } from '../../lib/db.js';

const currentPath = Astro.url.pathname;

// 1. Cek Sesi
const session = Astro.cookies.get('user_session');
if (!session) {
    return Astro.redirect('/login');
}

const userId = session.value;

// 2. Cek Otoritas
const [userRows] = await db.query('SELECT role FROM users WHERE id = ?', [userId]) as any;
if (userRows.length === 0 || userRows[0].role !== 'admin') {
    return Astro.redirect('/dashboard');
}

// 3. TANGKAP PARAMETER PENCARIAN, FILTER STATUS, & PENGURUTAN DARI URL
const searchQuery = Astro.url.searchParams.get('q')?.toLowerCase() || '';
const sortQuery = Astro.url.searchParams.get('sort') || 'terbaru';
const statusQuery = Astro.url.searchParams.get('status') || 'semua';

// 4. SUSUN QUERY SQL BERDASARKAN PENGURUTAN WAKTU
let sql = 'SELECT orders.id as order_id, users.nama, users.email, orders.jenis_paket, orders.nama_bisnis, orders.status, orders.tanggal_order, orders.catatan FROM orders JOIN users ON orders.user_id = users.id';

// Atur urutan berdasarkan pilihan dropdown
if (sortQuery === 'terlama') {
    sql += ' ORDER BY orders.tanggal_order ASC';
} else {
    sql += ' ORDER BY orders.tanggal_order DESC'; // Default terbaru
}

const [orders] = await db.query(sql) as any;

// 5. FILTER DATA BERDASARKAN STATUS DAN KATA KUNCI PENCARIAN
let filteredOrders = orders;

if (statusQuery !== 'semua') {
    filteredOrders = filteredOrders.filter((o: any) => o.status === statusQuery);
}

if (searchQuery) {
    filteredOrders = filteredOrders.filter((o: any) => 
        o.nama.toLowerCase().includes(searchQuery) || 
        o.email.toLowerCase().includes(searchQuery) || 
        o.nama_bisnis.toLowerCase().includes(searchQuery)
    );
}

// 6. KELOMPOKKAN PESANAN JADI FOLDER
const groupedOrders: any = {};
filteredOrders.forEach((o: any) => {
    if (!groupedOrders[o.email]) {
        groupedOrders[o.email] = {
            nama: o.nama,
            email: o.email,
            items: []
        };
    }
    groupedOrders[o.email].items.push(o);
});
const clientList = Object.values(groupedOrders);
