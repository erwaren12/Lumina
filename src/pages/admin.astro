            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-10">
                <div class="md:col-span-2 relative overflow-hidden bg-white/50 backdrop-blur-md border border-[#C8B8A3] p-6 rounded-3xl transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-[#EA580C]/10 group cursor-default">
