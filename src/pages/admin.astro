---
import "../styles/global.css";
import { db } from "../lib/db.js";

// 1. Proteksi Halaman
const session = Astro.cookies.get("user_session");
if (!session) return Astro.redirect("/login");

const userId = session.value;
const [userRows] = (await db.query("SELECT role FROM users WHERE id = ?", [
    userId,
])) as any;
if (userRows.length === 0 || userRows[0].role !== "admin")
    return Astro.redirect("/dashboard");

// 2. Ambil Semua Pesanan
const [orders] = (await db.query(`
    SELECT orders.id as order_id, users.nama, users.email, orders.jenis_paket, 
           orders.nama_bisnis, orders.status, orders.tanggal_order, orders.catatan
    FROM orders JOIN users ON orders.user_id = users.id 
    ORDER BY orders.tanggal_order DESC
`)) as any;

// 3. Hitung Statistik Ringkas
const totalRevenue = "12.5M"; // Bisa diotomatisasi dengan query SUM nantinya
const activeClients = orders.filter(
    (o: any) => o.status !== "Selesai / Live",
).length;
const completedOrders = orders.filter(
    (o: any) => o.status === "Selesai / Live",
).length;
---

<html lang="id" data-theme="light">
    <head>
        <meta charset="utf-8" />
        <title>Admin Panel | PyntaDev</title>
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap"
            rel="stylesheet"
        />
        <style is:global>
            @import "tailwindcss";
            body {
                font-family: "Inter", sans-serif;
                background-color: #e3d5c1;
                color: #2e1f1a;
            }
            .modal-hidden {
                opacity: 0;
                visibility: hidden;
                pointer-events: none;
            }
            #modal-content {
                transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            }
            .modal-hidden #modal-content {
                transform: scale(0.9) translateY(20px);
            }
        </style>
    </head>
    <body class="min-h-screen w-full">
        <nav
            class="w-full bg-[#1A110E] p-4 text-[#E3D5C1] flex justify-between items-center shadow-lg sticky top-0 z-40"
        >
            <div class="font-black text-xl px-4 italic">
                Pynta<span class="text-[#EA580C]">Admin</span>
            </div>
            <a
                href="/dashboard"
                class="px-4 py-2 bg-[#2E1F1A] hover:bg-[#EA580C] rounded-lg text-sm font-bold transition-all"
                >Mode Klien</a
            >
        </nav>

        <main class="p-8 lg:p-12 max-w-7xl mx-auto">
            <header class="mb-10">
                <div
                    class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#EA580C] text-white text-[10px] font-black tracking-wide mb-4 shadow-sm uppercase"
                >
                    🛠️ Panel Manajemen
                </div>
                <h1 class="text-4xl font-black text-[#2E1F1A]">
                    Ruang Kendali Pesanan
                </h1>
                <p class="text-[#7B6153] font-medium">
                    Pantau proyek dan kirim pesan instruksi ke dashboard klien.
                </p>
            </header>

            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-10">
                <div
                    class="md:col-span-2 bg-white/50 backdrop-blur-md border border-[#C8B8A3] p-6 rounded-3xl relative overflow-hidden"
                >
                    <div
                        class="absolute -right-10 -top-10 w-40 h-40 bg-[#EA580C]/10 rounded-full blur-3xl"
                    >
                    </div>
                    <h3
                        class="text-[#7B6153] text-xs font-bold uppercase tracking-widest mb-2"
                    >
                        📊 Estimasi Pendapatan
                    </h3>
                    <div class="text-5xl font-black text-[#2E1F1A]">
                        Rp {totalRevenue}
                    </div>
                </div>
                <div
                    class="bg-white/50 backdrop-blur-md border border-[#C8B8A3] p-6 rounded-3xl"
                >
                    <h3 class="text-[#7B6153] text-xs font-bold uppercase mb-2">
                        Klien Aktif
                    </h3>
                    <div class="text-4xl font-black text-[#2E1F1A]">
                        {activeClients}
                    </div>
                </div>
                <div
                    class="bg-white/50 backdrop-blur-md border border-[#C8B8A3] p-6 rounded-3xl"
                >
                    <h3 class="text-[#7B6153] text-xs font-bold uppercase mb-2">
                        Selesai
                    </h3>
                    <div class="text-4xl font-black text-green-600">
                        {completedOrders}
                    </div>
                </div>
            </div>

            <div
                class="bg-white rounded-2xl shadow-xl overflow-hidden border border-[#C8B8A3]"
            >
                <table class="w-full text-left">
                    <thead
                        class="bg-[#2E1F1A] text-[#E3D5C1] text-sm uppercase"
                    >
                        <tr>
                            <th class="p-5 font-bold">Klien</th>
                            <th class="p-5 font-bold">Bisnis & Paket</th>
                            <th class="p-5 font-bold">Aksi Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#C8B8A3]">
                        {
                            orders.map((order: any) => (
                                <tr class="hover:bg-[#F5EEDB] transition-colors group">
                                    <td class="p-5">
                                        <button
                                            class="btn-detail text-left outline-none group-hover:translate-x-1 transition-transform"
                                            data-id={order.order_id}
                                            data-nama={order.nama}
                                            data-email={order.email}
                                            data-bisnis={order.nama_bisnis}
                                            data-paket={order.jenis_paket}
                                            data-status={order.status}
                                            data-catatan={order.catatan || ""}
                                        >
                                            <div class="font-black text-[#2E1F1A] group-hover:text-[#EA580C]">
                                                {order.nama}
                                            </div>
                                            <div class="text-xs text-[#7B6153]">
                                                {order.email}
                                            </div>
                                        </button>
                                    </td>
                                    <td class="p-5">
                                        <div class="font-bold text-[#EA580C]">
                                            {order.nama_bisnis}
                                        </div>
                                        <div class="text-sm font-semibold">
                                            {order.jenis_paket}
                                        </div>
                                    </td>
                                    <td class="p-5">
                                        <div class="flex items-center gap-2">
                                            <select
                                                class="status-dropdown p-2 rounded-lg border border-[#C8B8A3] text-xs font-bold"
                                                data-id={order.order_id}
                                            >
                                                <option
                                                    value="Menunggu Pembayaran"
                                                    selected={
                                                        order.status ===
                                                        "Menunggu Pembayaran"
                                                    }
                                                >
                                                    Menunggu
                                                </option>
                                                <option
                                                    value="Sedang Dikerjakan"
                                                    selected={
                                                        order.status ===
                                                        "Sedang Dikerjakan"
                                                    }
                                                >
                                                    Proses
                                                </option>
                                                <option
                                                    value="Selesai / Live"
                                                    selected={
                                                        order.status ===
                                                        "Selesai / Live"
                                                    }
                                                >
                                                    Live
                                                </option>
                                                <option
                                                    value="Dibatalkan"
                                                    selected={
                                                        order.status ===
                                                        "Dibatalkan"
                                                    }
                                                >
                                                    Batal
                                                </option>
                                            </select>
                                            <button class="btn-update bg-[#2E1F1A] text-white px-3 py-2 rounded-lg text-[10px] font-bold hover:bg-[#EA580C]">
                                                Update
                                            </button>
                                            <button
                                                class="btn-delete bg-red-100 text-red-600 p-2 rounded-lg hover:bg-red-600 hover:text-white transition-all"
                                                data-id={order.order_id}
                                            >
                                                🗑️
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            ))
                        }
                    </tbody>
                </table>
            </div>
        </main>

        <div
            id="modal-client"
            class="fixed inset-0 z-50 flex items-center justify-center p-6 bg-[#1A110E]/60 backdrop-blur-sm modal-hidden"
        >
            <div
                id="modal-content"
                class="bg-[#F5EEDB] w-full max-w-lg rounded-3xl shadow-2xl border border-[#C8B8A3] overflow-hidden"
            >
                <div
                    class="bg-[#2E1F1A] p-6 text-[#E3D5C1] flex justify-between items-center"
                >
                    <h2 id="m-nama" class="text-2xl font-black italic">
                        Nama Klien
                    </h2>
                    <button
                        id="close-modal"
                        class="text-3xl hover:text-[#EA580C] transition-colors"
                        >&times;</button
                    >
                </div>
                <div class="p-8 space-y-6">
                    <div class="grid grid-cols-2 gap-4">
                        <div
                            class="bg-white/50 p-4 rounded-2xl border border-[#C8B8A3]"
                        >
                            <p
                                class="text-[10px] font-bold text-[#7B6153] uppercase mb-1"
                            >
                                Bisnis
                            </p>
                            <p id="m-bisnis" class="font-black text-[#2E1F1A]">
                            </p>
                        </div>
                        <div
                            class="bg-white/50 p-4 rounded-2xl border border-[#C8B8A3]"
                        >
                            <p
                                class="text-[10px] font-bold text-[#7B6153] uppercase mb-1"
                            >
                                Paket
                            </p>
                            <p id="m-paket" class="font-black text-[#EA580C]">
                            </p>
                        </div>
                    </div>
                    <div>
                        <p
                            class="text-xs font-bold text-blue-600 uppercase mb-2"
                        >
                            📢 Pesan Untuk Klien (Tampil di Dashboard)
                        </p>
                        <input type="hidden" id="m-order-id" />
                        <textarea
                            id="m-catatan"
                            class="w-full bg-white border border-blue-200 rounded-xl p-4 text-sm font-medium outline-none focus:ring-2 focus:ring-blue-500 min-h-[120px]"
                        ></textarea>
                        <button
                            id="btn-save-catatan"
                            class="mt-3 w-full bg-blue-600 text-white py-3 rounded-xl font-black text-sm hover:bg-blue-700 shadow-md transition-all"
                            >💾 Simpan & Tampilkan ke Klien</button
                        >
                    </div>
                </div>
            </div>
        </div>

        <script is:inline>
            // 1. Logika Modal
            const modal = document.getElementById("modal-client");
            const closeBtn = document.getElementById("close-modal");
            const detailBtns = document.querySelectorAll(".btn-detail");

            detailBtns.forEach((btn) => {
                btn.addEventListener("click", () => {
                    document.getElementById("m-order-id").value =
                        btn.dataset.id;
                    document.getElementById("m-nama").innerText =
                        btn.dataset.nama;
                    document.getElementById("m-bisnis").innerText =
                        btn.dataset.bisnis;
                    document.getElementById("m-paket").innerText =
                        btn.dataset.paket;
                    document.getElementById("m-catatan").value =
                        btn.dataset.catatan;
                    modal.classList.remove("modal-hidden");
                });
            });

            closeBtn.addEventListener("click", () =>
                modal.classList.add("modal-hidden"),
            );
            modal.addEventListener("click", (e) => {
                if (e.target === modal) modal.classList.add("modal-hidden");
            });

            // 2. Simpan Pesan Klien
            document
                .getElementById("btn-save-catatan")
                .addEventListener("click", async (e) => {
                    const btn = e.target;
                    const order_id =
                        document.getElementById("m-order-id").value;
                    const catatan = document.getElementById("m-catatan").value;
                    const originalText = btn.innerHTML;

                    btn.innerHTML = "⏳ Mengirim...";
                    btn.disabled = true;

                    const res = await fetch("/api/update-catatan", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ order_id, catatan }),
                    });

                    if (res.ok) {
                        btn.innerHTML = "✅ Terkirim!";
                        document.querySelector(
                            `.btn-detail[data-id="${order_id}"]`,
                        ).dataset.catatan = catatan;
                        setTimeout(() => {
                            btn.innerHTML = originalText;
                            btn.disabled = false;
                            modal.classList.add("modal-hidden");
                        }, 1500);
                    }
                });

            // 3. Update Status
            document.querySelectorAll(".btn-update").forEach((btn) => {
                btn.addEventListener("click", async (e) => {
                    const select = e.target.previousElementSibling;
                    const order_id = select.dataset.id;
                    const status_baru = select.value;
                    const originalText = e.target.innerHTML;

                    e.target.innerHTML = "⏳";
                    const res = await fetch("/api/update-status", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ order_id, status_baru }),
                    });

                    if (res.ok) {
                        e.target.innerHTML = "OK!";
                        setTimeout(
                            () => (e.target.innerHTML = originalText),
                            2000,
                        );
                    }
                });
            });

            // 4. Hapus Permanen
            document.querySelectorAll(".btn-delete").forEach((btn) => {
                btn.addEventListener("click", async (e) => {
                    const order_id = e.currentTarget.dataset.id;
                    if (!confirm("Hapus pesanan ini secara PERMANEN?")) return;

                    const res = await fetch("/api/delete-order", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ order_id }),
                    });

                    if (res.ok) window.location.reload();
                });
            });
        </script>
    </body>
</html>
