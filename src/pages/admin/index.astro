            <div class="space-y-8">
                {clientList.length === 0 ? (
                    <div class="bg-white p-12 rounded-3xl text-center border border-[#C8B8A3] shadow-sm">
                        <span class="text-4xl mb-4 block">🕵️</span>
                        <h3 class="text-xl font-black text-[#2E1F1A] mb-2">Pencarian Tidak Ditemukan</h3>
                        <p class="text-[#7B6153] font-medium">Tidak ada klien atau pesanan yang cocok dengan filter yang kamu pilih.</p>
                    </div>
                ) : (
                    clientList.map((client: any) => (
                        <div class="bg-white/80 backdrop-blur-md rounded-[2rem] shadow-xl overflow-hidden border border-[#C8B8A3] transition-all hover:shadow-[#EA580C]/10">
                            
                            <div class="bg-[#2E1F1A] px-6 py-4 flex justify-between items-center border-b border-[#C8B8A3]">
                                <div class="flex items-center gap-4">
                                    <div class="bg-[#EA580C] text-white w-10 h-10 rounded-full flex items-center justify-center font-black text-xl shadow-inner">
                                        {client.nama.charAt(0).toUpperCase()}
                                    </div>
                                    <div>
                                        <h2 class="text-lg font-black text-[#E3D5C1] leading-tight">{client.nama}</h2>
                                        <p class="text-xs font-medium text-[#C8B8A3]">{client.email}</p>
                                    </div>
                                </div>
                                <div class="bg-[#E3D5C1] text-[#2E1F1A] px-4 py-1.5 rounded-full text-[10px] font-black uppercase tracking-wider shadow-sm flex items-center gap-2">
                                    📁 {client.items.length} Proyek
                                </div>
                            </div>

                            <div class="overflow-x-auto">
                                <table class="w-full text-left border-collapse">
                                    <thead class="bg-[#F5EEDB] text-[#7B6153] text-[10px] uppercase tracking-widest border-b border-[#C8B8A3]">
                                        <tr>
                                            <th class="p-4 pl-8 font-bold w-1/3">Bisnis & Paket</th>
                                            <th class="p-4 font-bold">Tanggal</th>
                                            <th class="p-4 pr-8 font-bold">Aksi Status</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-[#C8B8A3]">
                                        {client.items.map((order: any) => (
                                            <tr class="hover:bg-[#F5EEDB]/60 transition-colors group">
                                                <td class="p-5 pl-8">
                                                    <button class="btn-detail text-left outline-none group-hover:translate-x-1 transition-transform" data-id={order.order_id} data-nama={client.nama} data-email={client.email} data-bisnis={order.nama_bisnis} data-paket={order.jenis_paket} data-status={order.status} data-tgl={new Date(order.tanggal_order).toLocaleDateString('id-ID')} data-catatan={order.catatan || ""}>
                                                        <div class="font-black text-[#EA580C] text-lg">{order.nama_bisnis}</div>
                                                        <div class="text-xs font-semibold text-[#2E1F1A] mt-0.5">{order.jenis_paket}</div>
                                                        {order.catatan && <span class="inline-block mt-2 text-[9px] font-black bg-blue-100 text-blue-600 px-2 py-0.5 rounded-full border border-blue-200 uppercase tracking-wide">💬 Ada Pesan</span>}
                                                    </button>
                                                </td>
                                                <td class="p-5 text-sm font-medium text-[#7B6153]">
                                                    {new Date(order.tanggal_order).toLocaleDateString('id-ID')}
                                                </td>
                                                <td class="p-5 pr-8">
                                                    <div class="flex items-center gap-3">
                                                        <select class="status-dropdown px-3 py-2 rounded-xl border border-[#C8B8A3] bg-white text-xs font-bold text-[#2E1F1A] cursor-pointer transition-all" data-id={order.order_id}>
                                                            <option value="Menunggu Pembayaran" selected={order.status === "Menunggu Pembayaran"}>Menunggu Pembayaran</option>
                                                            <option value="Sedang Dikerjakan" selected={order.status === "Sedang Dikerjakan"}>Sedang Dikerjakan</option>
                                                            <option value="Selesai / Live" selected={order.status === "Selesai / Live"}>Selesai / Live</option>
                                                            <option value="Dibatalkan" selected={order.status === "Dibatalkan"}>Dibatalkan</option>
                                                        </select>
                                                        <button class="btn-update bg-[#2E1F1A] text-white px-4 py-2 rounded-xl text-xs font-bold hover:bg-[#EA580C] transition-colors shadow-md active:scale-95">Update</button>
                                                        <button class="btn-delete-order bg-red-50 text-red-500 border border-red-200 p-2 rounded-xl hover:bg-red-500 hover:text-white transition-colors shadow-sm" data-id={order.order_id} title="Hapus Permanen">🗑️</button>
                                                    </div>
                                                </td>
                                            </tr>
                                        ))}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    ))
                )}
            </div>
            </main>

        <div id="modal-client" class="fixed inset-0 z-50 flex items-center justify-center p-6 bg-[#1A110E]/60 backdrop-blur-sm modal-hidden">
            <div id="modal-content" class="bg-[#F5EEDB] w-full max-w-lg rounded-3xl shadow-2xl border border-[#C8B8A3] overflow-hidden">
                <div class="bg-[#2E1F1A] p-6 text-[#E3D5C1] flex justify-between items-center">
                    <div>
                        <h2 id="m-nama" class="text-2xl font-black">Nama Klien</h2>
                        <p id="m-email" class="text-sm opacity-70">email@klien.com</p>
                    </div>
                    <button id="close-modal" class="p-2 hover:bg-white/10 rounded-full transition-colors text-2xl">&times;</button>
                </div>
                <div class="p-8 space-y-6">
                    <div class="grid grid-cols-2 gap-4">
                        <div class="bg-white/50 p-4 rounded-2xl border border-[#C8B8A3]">
                            <p class="text-[10px] font-bold uppercase text-[#7B6153] mb-1">Nama Bisnis</p>
                            <p id="m-bisnis" class="font-black text-[#2E1F1A]">Nama Toko</p>
                        </div>
                        <div class="bg-white/50 p-4 rounded-2xl border border-[#C8B8A3]">
                            <p class="text-[10px] font-bold uppercase text-[#7B6153] mb-1">Paket Layanan</p>
                            <p id="m-paket" class="font-black text-[#EA580C]">Katalog Basic</p>
                        </div>
                    </div>
                    <div>
                        <p class="text-xs font-bold uppercase text-blue-600 mb-2 flex items-center gap-2">📢 Pesan Untuk Klien (Tampil di Dashboard)</p>
                        <input type="hidden" id="m-order-id" value="">
                        <textarea id="m-catatan" placeholder="Tulis pesan status untuk klien... (Contoh: Mohon segera transfer ke BCA 12345)" class="w-full bg-white border border-blue-300 rounded-xl p-4 text-sm font-medium focus:ring-2 focus:ring-blue-600 outline-none min-h-[100px] transition-all"></textarea>
                        <button id="btn-save-catatan" class="mt-3 w-full bg-blue-600 text-white py-3.5 rounded-xl font-black text-sm hover:bg-blue-700 transition-colors shadow-md active:scale-[0.98]">💾 Simpan & Tampilkan ke Klien</button>
                    </div>
                </div>
            </div>
        </div>

        <script is:inline>
            // --- LOGIKA UPDATE STATUS ---
            const updateButtons = document.querySelectorAll('.btn-update');
            updateButtons.forEach(button => {
                button.addEventListener('click', async (e) => {
                    const selectElement = e.target.previousElementSibling;
                    const order_id = selectElement.getAttribute('data-id');
                    const status_baru = selectElement.value;
                    const originalText = e.target.innerHTML;
                    e.target.innerHTML = "⏳";
                    e.target.disabled = true;

                    try {
                        const response = await fetch('/api/update-status', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ order_id, status_baru })
                        });
                        const result = await response.json();
                        if (response.ok) {
                            alert("✅ " + result.message);
                            e.target.innerHTML = "OK!";
                            e.target.classList.replace('bg-[#2E1F1A]', 'bg-green-600');
                            e.target.classList.replace('hover:bg-[#EA580C]', 'hover:bg-green-700');
                            setTimeout(() => {
                                e.target.innerHTML = originalText;
                                e.target.classList.replace('bg-green-600', 'bg-[#2E1F1A]');
                                e.target.classList.replace('hover:bg-green-700', 'hover:bg-[#EA580C]');
                                e.target.disabled = false;
                            }, 2000);
                        } else {
                            alert("❌ Gagal: " + result.message);
                            e.target.innerHTML = originalText;
                            e.target.disabled = false;
                        }
                    } catch (error) {
                        alert("❌ Terjadi kesalahan pada server.");
                        e.target.innerHTML = originalText;
                        e.target.disabled = false;
                    }
                });
            });

            // --- LOGIKA MODAL CRM BUKA TUTUP ---
            const modal = document.getElementById('modal-client');
            const closeBtn = document.getElementById('close-modal');
            const detailBtns = document.querySelectorAll('.btn-detail');

            detailBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    document.getElementById('m-order-id').value = btn.dataset.id;
                    document.getElementById('m-nama').innerText = btn.dataset.nama;
                    document.getElementById('m-email').innerText = btn.dataset.email;
                    document.getElementById('m-bisnis').innerText = btn.dataset.bisnis;
                    document.getElementById('m-paket').innerText = btn.dataset.paket;
                    document.getElementById('m-catatan').value = btn.dataset.catatan;
                    
                    modal.classList.remove('modal-hidden');
                });
            });

            closeBtn.addEventListener('click', () => modal.classList.add('modal-hidden'));
            modal.addEventListener('click', (e) => { if(e.target === modal) modal.classList.add('modal-hidden'); });

            // --- LOGIKA SIMPAN PESAN CRM ---
            document.getElementById('btn-save-catatan').addEventListener('click', async (e) => {
                const btn = e.target;
                const order_id = document.getElementById('m-order-id').value;
                const catatan = document.getElementById('m-catatan').value;
                
                const originalText = btn.innerHTML;
                btn.innerHTML = "⏳ Menyimpan...";
                btn.disabled = true;

                try {
                    const response = await fetch('/api/update-catatan', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ order_id, catatan })
                    });

                    if (response.ok) {
                        btn.innerHTML = "✅ Tersimpan!";
                        btn.classList.replace('bg-blue-600', 'bg-green-600');
                        btn.classList.replace('hover:bg-blue-700', 'hover:bg-green-700');
                        document.querySelector(`.btn-detail[data-id="${order_id}"]`).dataset.catatan = catatan;
                    } else {
                        alert("❌ Gagal menyimpan catatan.");
                    }
                } catch (error) {
                    alert("❌ Error server saat menyimpan.");
                } finally {
                    setTimeout(() => {
                        btn.innerHTML = originalText;
                        btn.classList.replace('bg-green-600', 'bg-blue-600');
                        btn.classList.replace('hover:bg-green-700', 'hover:bg-blue-700');
                        btn.disabled = false;
                        modal.classList.add('modal-hidden');
                    }, 1500);
                }
            });

            // --- LOGIKA HAPUS PERMANEN OLEH ADMIN ---
            document.querySelectorAll('.btn-delete-order').forEach(btn => {
                btn.addEventListener('click', async (e) => {
                    const order_id = e.currentTarget.getAttribute('data-id');
                    
                    if(!confirm("🚨 PERINGATAN BUKAN MAIN-MAIN 🚨\n\nYakin ingin menghapus pesanan ini secara PERMANEN dari database? Data tidak bisa dikembalikan!")) return;
                    
                    const originalHTML = e.currentTarget.innerHTML;
                    e.currentTarget.innerHTML = "⏳";
                    
                    try {
                        const res = await fetch('/api/delete-order', {
                            method: 'POST',
                            headers: {'Content-Type': 'application/json'},
                            body: JSON.stringify({ order_id })
                        });
                        
                        const data = await res.json();
                        
                        if(res.ok) {
                            alert("✅ " + data.message);
                            window.location.reload(); 
                        } else {
                            alert("❌ Gagal: " + data.message);
                            e.currentTarget.innerHTML = originalHTML;
                        }
                    } catch (err) {
                        alert("❌ Error Jaringan/Sistem: " + err.message);
                        e.currentTarget.innerHTML = originalHTML;
                    }
                });
            });
        </script>
    </body>
</html>