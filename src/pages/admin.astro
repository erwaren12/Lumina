---
import '../styles/global.css';
import { db } from '../lib/db.js';

// 1. Cek Sesi
const session = Astro.cookies.get('user_session');

if (!session) {
    return Astro.redirect('/login');
}

const userId = session.value;

// 2. Cek Otoritas
const [userRows] = await db.query('SELECT role FROM users WHERE id = ?', [userId]) as any;

if (userRows.length === 0 || userRows[0].role !== 'admin') {
    return Astro.redirect('/dashboard');
}

// 3. Admin, Ambil Data Pesananan (Sudah ditambah orders.catatan)
const [orders] = await db.query(`
    SELECT 
        orders.id as order_id, 
        users.nama, 
        users.email, 
        orders.jenis_paket, 
        orders.nama_bisnis, 
        orders.status, 
        orders.tanggal_order,
        orders.catatan 
    FROM orders 
    JOIN users ON orders.user_id = users.id 
    ORDER BY orders.tanggal_order DESC
`) as any;
---
<html lang="id" data-theme="light">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>Admin Panel | PyntaDev</title>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
        <style is:global>
            @import "tailwindcss";

            /* --- TOGLE LOGO GAMBAR --- */
            .logo-dark-mode { display: block; }
            .logo-light-mode { display: none; }
            
            [data-theme="light"] .logo-dark-mode { display: none !important; }
            [data-theme="light"] .logo-light-mode { display: block !important; }

            body { 
                font-family: 'Inter', sans-serif; 
                background-color: #E3D5C1; 
                color: #2E1F1A; 
                margin: 0; 
                padding: 0; 
            }
            
            select:focus, textarea:focus { 
                outline: none; 
                border-color: #EA580C; 
                box-shadow: 0 0 0 3px rgba(234, 88, 12, 0.2);
            }

            /* Modal Animation */
            #modal-client { transition: opacity 0.3s ease, visibility 0.3s ease; }
            #modal-content { transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); }
            .modal-hidden { opacity: 0; visibility: hidden; pointer-events: none; }
            .modal-hidden #modal-content { transform: scale(0.9) translateY(20px); }
        </style>
    </head>
    
    <body class="min-h-screen w-full relative">
        
        <nav class="w-full bg-[#1A110E] p-4 text-[#E3D5C1] flex justify-between items-center shadow-lg">
