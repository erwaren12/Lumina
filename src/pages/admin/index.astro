                    <input type="text" name="q" value={searchQuery} placeholder="Cari nama klien, email, atau nama bisnis..." class="w-full pl-12 pr-4 py-3.5 rounded-2xl border border-[#C8B8A3] focus:border-[#EA580C] outline-none bg-white text-sm font-bold text-[#2E1F1A] transition-all" />
