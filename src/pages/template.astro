            }
            .whatsapp-fab:hover { transform: translateY(-5px) scale(1.05); }
            .whatsapp-fab::after {
                content: ''; position: absolute; width: 100%; height: 100%;
                background-color: #25D366; border-radius: 9999px; opacity: 0.5;
                z-index: -1; animation: wa-pulse 2s infinite;
            }
            [data-theme="light"] a.fixed.bottom-6.right-6 svg.w-8.h-8 { color: #FFFFFF !important; }
        </style>
