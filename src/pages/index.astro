---
import '../styles/global.css';

// CEK APAKAH ADA USER YANG SEDANG LOGIN
const session = Astro.cookies.get('user_session');
const isLoggedIn = !!session; // Hasilnya true jika sudah login, false jika belum
---
<html lang="id">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>Solusi Agensi Digital Terpercaya | PyntaDev</title>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
        
        <script is:inline>
            // --- SKRIP DETEKSI TEMA INSTAN (Mencegah Flash Putih) ---
            const savedTheme = localStorage.getItem('theme') || 'light';
            if (savedTheme === 'light') {
                document.documentElement.setAttribute('data-theme', 'light');
            } else {
                document.documentElement.removeAttribute('data-theme');
            }
        </script>
        
        <style is:global>
            /* CSS KHUSUS HALAMAN HOME (Hanya yang tidak masuk global.css) */
            @keyframes blink { 0%, 100% { border-color: transparent; } 50% { border-color: #EA580C; } }
            @keyframes shimmer { 100% { transform: translateX(100%); } }
            
            #typewriter { color: #EA580C !important; -webkit-text-fill-color: #EA580C !important; background: none !important; padding: 0; }
            #klien-title { color: #EA580C !important; }
            #klien-logos { filter: grayscale(1); opacity: 0.6; }
            [data-theme="light"] #klien-logos { filter: none !important; opacity: 1 !important; }
            [data-theme="light"] #klien-logos div { color: #2E1F1A !important; }
            [data-theme="light"] #slider-testimoni .text-white { color: #2E1F1A !important; }
            [data-theme="light"] div.bg-slate-900.px-4.py-3 { background-color: #E3D5C1 !important; border-bottom: 1px solid #C8B8A3 !important; }
            [data-theme="light"] div.bg-slate-800.px-3.py-1.rounded { background-color: transparent !important; color: #2E1F1A !important; border: 1px solid #C8B8A3 !important; }
            [data-theme="light"] .bg-slate-700\/50 { background-color: #F5EEDB !important; border: 1px solid #C8B8A3 !important; color: #7B6153 !important; }
            [data-theme="light"] .bg-slate-700\/30 { background-color: #E3D5C1 !important; border: 1px solid #C8B8A3 !important; }
        </style>
    </head>
    <body class="bg-slate-900 text-slate-300 font-sans antialiased selection:bg-blue-500 selection:text-white flex flex-col min-h-screen transition-colors duration-500">
        
        <header class="fixed w-full top-0 z-50 transition-all shadow-lg">
            <div class="bg-slate-950 border-b border-slate-800 hidden lg:block transition-colors duration-500">
                <div class="container mx-auto px-6 py-2 flex justify-between items-center text-xs text-slate-400 font-medium">
                    <div class="flex items-center gap-6">
                        <span class="flex items-center gap-2">📞 +62 851-7745-3386</span>
                        <span class="flex items-center gap-2">⏰ Setiap Hari 09.00 - 21.00</span>
                    </div>
                    <div class="flex items-center gap-1 cursor-pointer hover:text-blue-500 transition">🌐 ID</div>
                </div>
            </div>
            <nav class="bg-slate-900/85 backdrop-blur-lg border-b border-slate-700/50 relative z-50 transition-colors duration-500">
                <div class="container mx-auto px-6 py-4 flex justify-between items-center">
                    <a href="/" class="text-3xl font-extrabold text-white tracking-tight flex items-center gap-2 hover:opacity-80 transition z-50">
                        <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center text-sm shadow-lg text-white">🚀</div>
                        Pynta<span class="text-blue-500">Dev</span>
                    </a>
                    
                    <div class="hidden lg:flex space-x-8 text-sm font-bold text-slate-300">
                        <a href="/" class="text-white font-bold underline decoration-blue-500 decoration-4 underline-offset-8">Home</a>
                        <a href="/template" class="hover:text-blue-500 transition-all">Template</a>
                        <a href="/portofolio" class="hover:text-blue-500 transition-all">Portofolio</a>
                        <a href="/harga" class="hover:text-blue-500 transition-all">Harga</a>
                    </div>
                    
                    <div class="hidden lg:flex items-center gap-4 md:gap-5">
                        <button id="theme-toggle-desktop" class="w-9 h-9 rounded-xl bg-slate-800 flex items-center justify-center text-slate-300 hover:text-yellow-400">☀️</button>
                        <div class="flex items-center gap-3 text-sm font-bold">
                            {isLoggedIn ? ( <a href="/dashboard" class="text-blue-500">Dashboard Saya</a> ) : ( <><a href="/login" class="text-slate-300 hover:text-blue-500">Login</a> <a href="/register" class="text-blue-500">Daftar</a></> )}
                        </div>
                        <a href="https://wa.me/6285177453386" target="_blank" class="bg-blue-600 text-white px-5 py-2.5 rounded-xl text-sm font-bold shadow-lg transition-all transform hover:-translate-y-1">Konsultasi</a>
                    </div>
                    <button id="mobile-menu-btn" class="lg:hidden text-slate-300 hover:text-blue-500 p-2"><svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path></svg></button>
                </div>
            </nav>
            <div id="mobile-menu" class="fixed inset-0 bg-slate-950/95 backdrop-blur-2xl z-40 transform translate-x-full transition-transform duration-300 flex flex-col items-center justify-center space-y-6 text-xl font-extrabold lg:hidden">
                <button id="theme-toggle-mobile" class="absolute top-24 w-12 h-12 rounded-full bg-slate-800 flex items-center justify-center text-2xl text-slate-300">☀️</button>
                <a href="/" class="text-white hover:text-blue-500 transition-colors mt-10">Home</a> <a href="/template" class="text-slate-300 hover:text-blue-500">Template</a> <a href="/portofolio" class="text-slate-300 hover:text-blue-500">Portofolio</a> <a href="/harga" class="text-slate-300 hover:text-blue-500">Harga</a>
                <div class="w-16 h-px bg-slate-700 my-2"></div>
                {isLoggedIn ? ( <a href="/dashboard" class="text-blue-500">Dashboard Saya</a> ) : ( <><a href="/login" class="text-slate-300 hover:text-blue-500">Login</a> <a href="/register" class="text-blue-500">Daftar</a></> )}
                <a href="https://wa.me/6285177453386" class="mt-4 bg-blue-600 text-white px-8 py-3 rounded-full text-base">Konsultasi WA</a>
            </div>
        </header>

        <main class="transition-colors duration-500 flex-1">
            <section class="container mx-auto px-6 pt-48 pb-24 md:pt-64 md:pb-32 text-center relative z-10">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 text-blue-500 text-xs font-bold mb-6 animate-pulse">🚀 PENGERJAAN EKSPRES 12 JAM</div>
                <h1 class="text-5xl md:text-7xl font-extrabold text-white mb-6 tracking-tight transition-colors duration-500">Website Elegan. <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-500 to-cyan-400">Siap Jualan.</span></h1>
                <p class="text-xl text-slate-400 max-w-2xl mx-auto mb-10 transition-colors duration-500">Platform katalog pro & e-commerce terintegrasi AI Agent Sales. Memulai jejak digital Anda tidak pernah semudah dan secepat ini.</p>
                <div class="flex flex-col sm:flex-row justify-center gap-4"> <a href="/harga" class="bg-blue-600 text-white px-10 py-4 rounded-xl font-bold text-lg hover:-translate-y-1 transition-transform shadow-lg shadow-blue-600/30">Pilih Paket</a> <a href="/template" class="border-2 border-slate-700 text-slate-300 px-10 py-4 rounded-xl font-bold text-lg hover:border-blue-500 hover:text-blue-500 transition-colors">Lihat Demo</a> </div>
            </section>
        </main>

        <footer class="bg-slate-950 pt-20 pb-10 mt-auto relative z-10 transition-colors duration-500">
            <div class="container mx-auto px-6">
                <div class="border-t-2 border-slate-800 pt-8 flex flex-col md:flex-row justify-between items-center gap-6 transition-colors duration-500">
                    <div class="text-slate-500 text-xs font-medium transition-colors duration-500">© 2026 PyntaDev Agency. All rights reserved.</div>
                </div>
            </div>
        </footer>

        <a href="https://wa.me/6285177453386" target="_blank" class="whatsapp-fab" title="Konsultasi via WhatsApp">
            <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.414 0 0 5.414 0 12.05c0 2.123.551 4.197 1.594 6.02L0 24l6.117-1.606a11.777 11.777 0 005.93 1.606h.005c6.632 0 12.049-5.417 12.049-12.05 0-3.218-1.253-6.244-3.526-8.517z"></path>
            </svg>
        </a>

        <script is:inline>
            // --- SKRIP TOGGLE TEMA & MENU ---
            const btnDesktop = document.getElementById('theme-toggle-desktop');
            const btnMobile = document.getElementById('theme-toggle-mobile');
            const html = document.documentElement;
            
            let isLight = localStorage.getItem('theme') === 'light' || localStorage.getItem('theme') === null;

            function updateThemeUI(light) {
                if (light) {
                    html.setAttribute('data-theme', 'light');
                    if (btnDesktop) btnDesktop.innerText = '🌙';
                    if (btnMobile) btnMobile.innerText = '🌙';
                } else {
                    html.removeAttribute('data-theme');
                    if (btnDesktop) btnDesktop.innerText = '☀️';
                    if (btnMobile) btnMobile.innerText = '☀️';
                }
            }
            
            updateThemeUI(isLight);

            function toggleTheme() {
                isLight = !isLight;
                localStorage.setItem('theme', isLight ? 'light' : 'dark');
                updateThemeUI(isLight);
            }

            if (btnDesktop) btnDesktop.addEventListener('click', toggleTheme);
            if (btnMobile) btnMobile.addEventListener('click', toggleTheme);

            const btnMenu = document.getElementById('mobile-menu-btn');
            const menu = document.getElementById('mobile-menu');
            let menuOpen = false;
            if (btnMenu) {
                btnMenu.addEventListener('click', () => {
                    menuOpen = !menuOpen;
                    if (menuOpen) {
                        menu.classList.remove('translate-x-full');
                        btnMenu.innerHTML = '<svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>';
                    } else {
                        menu.classList.add('translate-x-full');
                        btnMenu.innerHTML = '<svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path></svg>';
                    }
                });
            }
        </script>
    </body>
</html>