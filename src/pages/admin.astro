        <div id="modal-client" class="fixed inset-0 z-50 flex items-center justify-center p-6 bg-[#1A110E]/60 backdrop-blur-sm modal-hidden">
            <div id="modal-content" class="bg-[#F5EEDB] w-full max-w-lg rounded-3xl shadow-2xl border border-[#C8B8A3] overflow-hidden">
                <div class="bg-[#2E1F1A] p-6 text-[#E3D5C1] flex justify-between items-center">
                    <div>
                        <h2 id="m-nama" class="text-2xl font-black">Nama Klien</h2>
                        <p id="m-email" class="text-sm opacity-70">email@klien.com</p>
                    </div>
                    <button id="close-modal" class="p-2 hover:bg-white/10 rounded-full transition-colors text-2xl">&times;</button>
                </div>
                <div class="p-8 space-y-6">
                    <div class="grid grid-cols-2 gap-4">
                        <div class="bg-white/50 p-4 rounded-2xl border border-[#C8B8A3]">
                            <p class="text-[10px] font-bold uppercase text-[#7B6153] mb-1">Nama Bisnis</p>
                            <p id="m-bisnis" class="font-black text-[#2E1F1A]">Nama Toko</p>
                        </div>
                        <div class="bg-white/50 p-4 rounded-2xl border border-[#C8B8A3]">
                            <p class="text-[10px] font-bold uppercase text-[#7B6153] mb-1">Paket Layanan</p>
                            <p id="m-paket" class="font-black text-[#EA580C]">Katalog Basic</p>
                        </div>
                    </div>
                    <div>
                        <p class="text-xs font-bold uppercase text-blue-600 mb-2 flex items-center gap-2">📢 Pesan Untuk Klien (Tampil di Dashboard)</p>
                        <input type="hidden" id="m-order-id" value="">
                        <textarea id="m-catatan" placeholder="Tulis pesan status untuk klien... (Contoh: Mohon segera transfer ke BCA 12345)" class="w-full bg-white border border-blue-300 rounded-xl p-4 text-sm font-medium focus:ring-2 focus:ring-blue-600 outline-none min-h-[100px] transition-all"></textarea>
                        <button id="btn-save-catatan" class="mt-3 w-full bg-blue-600 text-white py-2.5 rounded-xl font-black text-sm hover:bg-blue-700 transition-colors shadow-md active:scale-[0.98]">💾 Simpan & Tampilkan ke Klien</button>
                    </div>
                </div>
            </div>
        </div>

        <script is:inline>
            // --- LOGIKA UPDATE STATUS (ASLI) ---
            const updateButtons = document.querySelectorAll('.btn-update');
            updateButtons.forEach(button => {
                button.addEventListener('click', async (e) => {
                    const selectElement = e.target.previousElementSibling;
                    const order_id = selectElement.getAttribute('data-id');
                    const status_baru = selectElement.value;
                    const originalText = e.target.innerHTML;
                    e.target.innerHTML = "⏳";
                    e.target.disabled = true;

                    try {
                        const response = await fetch('/api/update-status', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ order_id, status_baru })
                        });
                        const result = await response.json();
                        if (response.ok) {
                            alert("✅ " + result.message);
                            e.target.innerHTML = "OK!";
                            e.target.classList.replace('bg-[#2E1F1A]', 'bg-green-600');
                            e.target.classList.replace('hover:bg-[#EA580C]', 'hover:bg-green-700');
                            setTimeout(() => {
                                e.target.innerHTML = originalText;
                                e.target.classList.replace('bg-green-600', 'bg-[#2E1F1A]');
                                e.target.classList.replace('hover:bg-green-700', 'hover:bg-[#EA580C]');
                                e.target.disabled = false;
                            }, 2000);
                        } else {
                            alert("❌ Gagal: " + result.message);
                            e.target.innerHTML = originalText;
                            e.target.disabled = false;
                        }
                    } catch (error) {
                        alert("❌ Terjadi kesalahan pada server.");
                        e.target.innerHTML = originalText;
                        e.target.disabled = false;
                    }
                });
            });

            // --- LOGIKA MODAL CRM BUKA TUTUP ---
            const modal = document.getElementById('modal-client');
            const closeBtn = document.getElementById('close-modal');
            const detailBtns = document.querySelectorAll('.btn-detail');

            detailBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    document.getElementById('m-order-id').value = btn.dataset.id;
                    document.getElementById('m-nama').innerText = btn.dataset.nama;
                    document.getElementById('m-email').innerText = btn.dataset.email;
                    document.getElementById('m-bisnis').innerText = btn.dataset.bisnis;
                    document.getElementById('m-paket').innerText = btn.dataset.paket;
                    document.getElementById('m-catatan').value = btn.dataset.catatan;
                    
                    modal.classList.remove('modal-hidden');
                });
            });

            closeBtn.addEventListener('click', () => modal.classList.add('modal-hidden'));
            modal.addEventListener('click', (e) => { if(e.target === modal) modal.classList.add('modal-hidden'); });

            // --- LOGIKA SIMPAN PESAN CRM ---
            document.getElementById('btn-save-catatan').addEventListener('click', async (e) => {
                const btn = e.target;
                const order_id = document.getElementById('m-order-id').value;
                const catatan = document.getElementById('m-catatan').value;
                
                const originalText = btn.innerHTML;
                btn.innerHTML = "⏳ Menyimpan...";
                btn.disabled = true;

                try {
                    const response = await fetch('/api/update-catatan', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ order_id, catatan })
                    });

                    if (response.ok) {
                        btn.innerHTML = "✅ Tersimpan!";
                        btn.classList.replace('bg-blue-600', 'bg-green-600');
                        btn.classList.replace('hover:bg-blue-700', 'hover:bg-green-700');
                        document.querySelector(`.btn-detail[data-id="${order_id}"]`).dataset.catatan = catatan;
                    } else {
                        alert("❌ Gagal menyimpan catatan.");
                    }
                } catch (error) {
                    alert("❌ Error server saat menyimpan.");
                } finally {
                    setTimeout(() => {
                        btn.innerHTML = originalText;
                        btn.classList.replace('bg-green-600', 'bg-blue-600');
                        btn.classList.replace('hover:bg-green-700', 'hover:bg-blue-700');
                        btn.disabled = false;
                        modal.classList.add('modal-hidden');
                    }, 1500);
                }
            });

            // --- LOGIKA HAPUS PERMANEN OLEH ADMIN ---
            document.querySelectorAll('.btn-delete-order').forEach(btn => {
                btn.addEventListener('click', async (e) => {
                    const order_id = e.currentTarget.getAttribute('data-id');
                    
                    if(!confirm("🚨 PERINGATAN BUKAN MAIN-MAIN 🚨\n\nYakin ingin menghapus pesanan ini secara PERMANEN dari database? Data tidak bisa dikembalikan!")) return;
                    
                    const originalHTML = e.currentTarget.innerHTML;
                    e.currentTarget.innerHTML = "⏳";
                    
                    try {
                        const res = await fetch('/api/delete-order', {
                            method: 'POST',
                            headers: {'Content-Type': 'application/json'},
                            body: JSON.stringify({ order_id })
                        });
                        
                        if(res.ok) {
                            alert("✅ Pesanan telah musnah dari muka bumi.");
                            window.location.reload(); 
                        } else {
                            alert("❌ Gagal menghapus pesanan.");
                            e.currentTarget.innerHTML = originalHTML;
                        }
                    } catch (err) {
                        alert("Error jaringan/server.");
                        e.currentTarget.innerHTML = originalHTML;
                    }
                });
            });
        </script>
    </body>
</html>