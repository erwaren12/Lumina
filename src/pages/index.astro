---
import '../styles/global.css';
import { db } from '../lib/db.js';

let portfolios = [];
let packages = [];
let errorServer = null;

try {
    // AMBIL DATA DARI TIDB UNTUK PORTOFOLIO DAN HARGA
    const [rowsPorto] = await db.query('SELECT * FROM portfolio ORDER BY created_at DESC LIMIT 3') as any;
    portfolios = rowsPorto;

    const [rowsHarga] = await db.query('SELECT * FROM paket_harga ORDER BY id ASC') as any;
    packages = rowsHarga;
} catch (err: any) {
    errorServer = err.message;
}

// Tambahkan baris ini agar 'currentPath' dikenali!
const currentPath = Astro.url.pathname;

// Cek Sudah Login (jika ada kode ini sebelumnya, biarkan saja)
const session = Astro.cookies.get('user_session');
const isLoggedIn = !!session;
