                    <select name="sort" class="px-4 py-3.5 rounded-2xl border border-[#C8B8A3] bg-white text-sm font-bold text-[#2E1F1A] focus:border-[#EA580C] outline-none cursor-pointer transition-all w-full md:w-auto" onchange="this.form.submit()">
                        <option value="terbaru" selected={sortQuery === 'terbaru'}>🕒 Terkini</option>
                        <option value="terlama" selected={sortQuery === 'terlama'}>⏳ Terlama</option>
