<html lang="id" data-theme="light">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>Admin Panel | PyntaDev</title>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap" rel="stylesheet">
        <style is:global>
            @import "tailwindcss";

            /* ==================================================== */
            /* 🔥 ULTIMATE SCROLLBAR KILLER (MEMAKSA HILANG) 🔥 */
            /* ==================================================== */
            html, body { 
                font-family: 'Inter', sans-serif; 
                background-color: #E3D5C1; 
                color: #2E1F1A; 
                margin: 0; 
                padding: 0;
                overflow-x: hidden;
                -ms-overflow-style: none !important;  /* IE dan Edge */
                scrollbar-width: none !important;  /* Firefox */
            }
            
            /* Chrome, Safari, Edge, Opera */
            ::-webkit-scrollbar { 
                display: none !important; 
                width: 0 !important;
                height: 0 !important;
            }

            * {
                -ms-overflow-style: none !important;
                scrollbar-width: none !important;
            }
            
            *::-webkit-scrollbar {
                display: none !important;
            }
            /* ==================================================== */

            select:focus, textarea:focus, input:focus { 
                outline: none; 
                border-color: #EA580C !important; 
                box-shadow: 0 0 0 3px rgba(234, 88, 12, 0.2);
            }

            /* Modal Animation */
            #modal-client { transition: opacity 0.3s ease, visibility 0.3s ease; }
            #modal-content { transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); }
            .modal-hidden { opacity: 0; visibility: hidden; pointer-events: none; }
            .modal-hidden #modal-content { transform: scale(0.9) translateY(20px); }
        </style>
    </head>
    
    <body class="min-h-screen w-full relative pb-20">
        
