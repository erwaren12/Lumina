                        <option value="semua" selected={statusQuery === 'semua'}>📌 Semua Status</option>
                        <option value="Menunggu Pembayaran" selected={statusQuery === 'Menunggu Pembayaran'}>⏳ Menunggu Pembayaran</option>
                        <option value="Sedang Dikerjakan" selected={statusQuery === 'Sedang Dikerjakan'}>⚙️ Sedang Dikerjakan</option>
                        <option value="Selesai / Live" selected={statusQuery === 'Selesai / Live'}>✅ Selesai / Live</option>
