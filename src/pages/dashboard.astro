---
import '../styles/global.css';
import { db } from '../lib/db.js';

const session = Astro.cookies.get('user_session');
if (!session) return Astro.redirect('/login');

const userId = session.value;
const [userRows] = await db.query('SELECT nama FROM users WHERE id = ?', [userId]) as any;
const user = userRows[0];

// Ambil SEMUA pesanan milik klien ini
const [orders] = await db.query('SELECT * FROM orders WHERE user_id = ? ORDER BY tanggal_order DESC', [userId]) as any;
const hasOrder = orders.length > 0;
---
<html lang="id" data-theme="light">
    <head>
        <meta charset="utf-8" />
        <title>Dashboard Klien | PyntaDev</title>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap" rel="stylesheet">
        <style is:global>
            @import "tailwindcss";
            body { font-family: 'Inter', sans-serif; background-color: #F5EEDB; color: #2E1F1A; }
        </style>
    </head>
    <body class="min-h-screen w-full flex flex-col lg:flex-row">
        
        <aside class="w-full lg:w-64 bg-[#2E1F1A] text-[#E3D5C1] p-8 flex flex-col gap-8 flex-shrink-0">
            <div class="text-2xl font-black italic">Pynta<span class="text-[#EA580C]">Dev</span></div>
            <nav class="flex flex-col gap-2 flex-grow">
                <a href="#" class="p-3 bg-[#EA580C] text-white rounded-xl font-bold">Ringkasan</a>
                <a href="/order" class="p-3 hover:bg-white/10 rounded-xl font-bold transition-all">Pesanan Baru</a>
                <div class="mt-auto pt-4 border-t border-white/10">
                    <button id="btnLogout" class="text-red-400 font-bold hover:text-red-300">Keluar Akun</button>
                </div>
            </nav>
        </aside>

        <main class="flex-1 p-8 lg:p-12 overflow-y-auto">
            <header class="mb-10">
                <h1 class="text-4xl font-black text-[#2E1F1A]">Halo, {user.nama}!</h1>
                <p class="text-[#7B6153] font-medium">Berikut adalah daftar proyek digital Anda.</p>
            </header>

            <div class="space-y-6">
                {hasOrder ? (
                    orders.map((order: any) => (
                        <div class="bg-[#E3D5C1] p-8 rounded-3xl border border-[#C8B8A3] shadow-sm relative overflow-hidden">
                            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 border-b border-[#C8B8A3] pb-4">
                                <div>
                                    <h3 class="text-2xl font-black text-[#2E1F1A]">{order.nama_bisnis}</h3>
                                    <p class="font-bold text-[#EA580C] uppercase text-xs">{order.jenis_paket}</p>
                                </div>
                                <div class="px-4 py-2 bg-[#2E1F1A] text-[#E3D5C1] text-[10px] font-black uppercase rounded-full">
                                    {order.status}
                                </div>
                            </div>

                            {/* Tombol Batal Klien */}
                            {order.status === 'Menunggu Pembayaran' && (
                                <button class="btn-cancel text-xs font-bold text-red-500 hover:text-red-700 underline mb-6" data-id={order.id}>
                                    Batalkan Pesanan Ini
                                </button>
                            )}

                            {/* Pesan dari Admin */}
                            {order.catatan && (
                                <div class="p-5 bg-white/60 backdrop-blur-sm border-l-4 border-[#EA580C] rounded-r-xl shadow-sm">
                                    <p class="text-[10px] font-black text-[#EA580C] uppercase mb-1">📢 Pesan dari PyntaDev:</p>
                                    <p class="text-sm text-[#2E1F1A] font-bold italic">"{order.catatan}"</p>
                                </div>
                            )}
                        </div>
                    ))
                ) : (
                    <div class="text-center p-20 bg-white/50 rounded-3xl border-2 border-dashed border-[#C8B8A3]">
                        <p class="text-[#7B6153] font-bold">Anda belum memiliki proyek aktif.</p>
                        <a href="/order" class="inline-block mt-4 px-8 py-3 bg-[#2E1F1A] text-white rounded-xl font-bold">Pesan Sekarang</a>
                    </div>
                )}
            </div>
        </main>

        <script is:inline>
            // Batal Pesanan
            document.querySelectorAll('.btn-cancel').forEach(btn => {
                btn.addEventListener('click', async (e) => {
                    if(!confirm("Yakin batalkan pesanan?")) return;
                    const order_id = e.target.dataset.id;
                    const res = await fetch('/api/cancel-order', {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json'},
                        body: JSON.stringify({ order_id })
                    });
                    if(res.ok) window.location.reload();
                });
            });

            // Logout
            document.getElementById('btnLogout')?.addEventListener('click', async () => {
                if(confirm("Keluar akun?")) {
                    await fetch('/api/logout', { method: 'POST' });
                    window.location.href = '/login';
                }
            });
        </script>
    </body>
</html>