                </div>
            </section>

            <section id="stats-section" class="py-12 bg-slate-950 border-t-2 border-b-2 border-slate-800/50 mb-24 rounded-[1.5rem]">
                <div class="container mx-auto px-6">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center" id="stats-container">
                        <div class="p-8"><div class="text-5xl font-black text-white mb-2">24+</div><div class="text-slate-400">Proyek Sukses</div></div>
                        <div class="p-8 border-slate-800 md:border-l-2 md:border-r-2"><div class="text-5xl font-black text-white mb-2">15+</div><div class="text-slate-400">Partner Terintegrasi (AI/Payment)</div></div>
                        <div class="p-8"><div class="text-5xl font-black text-white mb-2">100%</div><div class="text-slate-400">Kepuasan Klien</div></div>
                    </div>
                </div>
